{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:deploy": "pnpm --filter @repo/db db:deploy",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.6.1",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@8.15.6",
  "name": "agroapp",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.2",
      "path-to-regexp": ">=8.4.0",
      "brace-expansion": ">=1.1.12",
      "minimatch@3": ">=3.1.3",
      "js-yaml@4": ">=4.1.1",
      "flatted": ">=3.4.0",
      "picomatch@2": ">=2.3.2",
      "ajv@6": ">=6.14.0",
      "brace-expansion@2": ">=2.0.2"
    }
  }
}
